{
  "manifest_version": 3,
  "name": "EaaP Agent Extension",
  "version": "1.0.0",
  "permissions": [
    "webRequest",
    "storage",
    "tabs",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "https://app.internal.example.com/*",
    "http://127.0.0.1:18131/*",
    "http://127.0.0.1:18132/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
